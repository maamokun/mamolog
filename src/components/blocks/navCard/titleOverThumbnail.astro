---
import NavCardTitleOverThumbnail from "@/components/primitives/navCard/titleOverThumbnail.astro";
import { getEntry } from "astro:content";
import { coverSrc } from "@/lib/image";

interface Props {
    id: string;
}

const { id } = Astro.props;

let entry;
try {
    entry = await getEntry("blog", id);
} catch (error) {
    entry = null;
}

if (!entry) {
    throw new Error(`Blog post with id "${id}" not found`);
}

const isDraft = import.meta.env.PROD && entry.data.draft;
const title = entry.data.title;
const description = entry.data.description;
const coverImage = coverSrc(entry.data.coverImage);
const url = `/${id}`;
---

{!isDraft && (
    <NavCardTitleOverThumbnail
        url={url}
        title={title}
        description={description}
        coverImage={coverImage}
    />
)}
